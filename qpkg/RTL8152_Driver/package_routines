######################################################################
# Package routines for the Realtek r8152 USB Ethernet driver
######################################################################

QPKG_NAME="RTL8152_Driver"
QPKG_ROOT=$(/sbin/getcfg ${QPKG_NAME} Install_Path -f /etc/config/qpkg.conf)
DRIVER_FILE="r8152.ko"
KERNEL_VERSION=$(uname -r)
LOG_FILE="${QPKG_ROOT}/install.log"

# Logging function
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "${LOG_FILE}"
}

######################################################################
# Define any package specific operations that shall be performed when
# the package is installed.
######################################################################
pkg_pre_install(){
    log "=== Pre-installation started ==="
    # Compatibility is checked in pkg_install before the active driver is touched.
}

pkg_install(){
    log "=== Installation started ==="

    # Determine architecture and verify driver exists
    ARCH=$(uname -m)
    case "$ARCH" in
        aarch64)
            # QDK extracts architecture-specific files directly to QPKG_ROOT
            # Check both possible locations for compatibility
            if [ -f "${QPKG_ROOT}/${DRIVER_FILE}" ]; then
                log "Driver found in QPKG directory: ${QPKG_ROOT}/${DRIVER_FILE}"
            elif [ -f "${QPKG_ROOT}/arm_64/${DRIVER_FILE}" ]; then
                # Move to root for consistency
                mv "${QPKG_ROOT}/arm_64/${DRIVER_FILE}" "${QPKG_ROOT}/"
                log "Driver moved from arm_64/ to QPKG root"
            else
                log "ERROR: Driver not found in ${QPKG_ROOT}/ or ${QPKG_ROOT}/arm_64/"
                log "Contents of ${QPKG_ROOT}:"
                ls -la "${QPKG_ROOT}" 2>&1 | while read line; do log "  $line"; done
                return 1
            fi
            ;;
        *)
            log "ERROR: Unsupported architecture: $ARCH"
            return 1
            ;;
    esac

    DRIVER_PATH="${QPKG_ROOT}/${DRIVER_FILE}"
    FILE_VERMAGIC=$(strings "${DRIVER_PATH}" 2>/dev/null | grep "^vermagic=" | head -1 | cut -d= -f2-)
    case "${FILE_VERMAGIC}" in
        "${KERNEL_VERSION} "*)
            log "Kernel compatibility verified: ${FILE_VERMAGIC}"
            ;;
        *)
            log "ERROR: Module vermagic '${FILE_VERMAGIC}' does not match running kernel '${KERNEL_VERSION}'"
            log "No loaded driver has been changed. Rebuild for this exact QTS kernel."
            return 1
            ;;
    esac

    if ! strings "${DRIVER_PATH}" 2>/dev/null | grep -qi "alias=usb:v0BDAp8157"; then
        log "ERROR: Packaged module does not advertise RTL8157 USB ID 0bda:8157"
        return 1
    fi
    log "RTL8157 USB ID support verified"

    # NOTE: /lib/modules is often read-only on QNAP systems
    # We keep the driver in QPKG directory and load from there
    log "Driver will be loaded from QPKG directory (read-only /lib/modules)"

    # Update module dependencies (in case other modules need to be updated)
    depmod -a 2>/dev/null || true
    log "Updated module dependencies"
}

pkg_post_install(){
    log "=== Post-installation started ==="

    # Load driver from QPKG directory (not /lib/modules which is read-only on QNAP)
    DRIVER_PATH="${QPKG_ROOT}/${DRIVER_FILE}"

    if [ -f "${DRIVER_PATH}" ]; then
        log "Driver path: ${DRIVER_PATH}"
        log "Driver size: $(ls -lh "${DRIVER_PATH}" 2>/dev/null | awk '{print $5}')"

        # Unload only after pkg_install has verified architecture, vermagic, and
        # the RTL8157 USB alias.
        if lsmod | grep -q "^r8152 "; then
            log "Unloading existing r8152 module..."
            if ! rmmod r8152 2>/dev/null; then
                log "ERROR: Could not unload the active r8152 module; leaving it in place"
                return 1
            fi
            sleep 1
        fi

        # Force load with insmod using absolute path from QPKG directory
        # This bypasses the module system and /lib/modules entirely
        log "Loading driver directly from QPKG directory with insmod..."
        if insmod "${DRIVER_PATH}" 2>/dev/null; then
            log "Driver loaded successfully via insmod from QPKG directory"
        else
            # Log detailed error information
            log "ERROR: Driver loading failed"
            log "Kernel version: $(uname -r)"

            # Try to get more error details
            dmesg | tail -20 | grep -i "r8152\|rtl" | while read line; do
                log "  dmesg: $line"
            done 2>/dev/null || true

            # We already unloaded the stock driver above, so put something back
            # rather than leaving the NIC with no driver at all.
            log "Restoring the stock driver..."
            if modprobe r8152 2>/dev/null; then
                log "Stock r8152 restored"
            else
                log "CRITICAL: Could not restore the stock r8152 module"
            fi
            return 1
        fi

        # Verify driver is loaded using srcversion (NOT size!)
        if lsmod | grep -q "^r8152 "; then
            log "Driver module is loaded"

            # Get srcversion to verify correct module
            LOADED_SRC=$(cat /sys/module/r8152/srcversion 2>/dev/null)
            FILE_SRC=$(strings "${DRIVER_PATH}" 2>/dev/null | grep "^srcversion=" | cut -d= -f2)

            if [ -n "${LOADED_SRC}" ] && [ -n "${FILE_SRC}" ]; then
                if [ "${LOADED_SRC}" = "${FILE_SRC}" ]; then
                    log "SUCCESS: Correct module verified (srcversion: ${LOADED_SRC})"
                else
                    log "ERROR: Different module loaded!"
                    log "  Expected srcversion: ${FILE_SRC}"
                    log "  Loaded srcversion: ${LOADED_SRC}"
                    return 1
                fi
            else
                log "INFO: Cannot verify srcversion (may not be available)"
            fi

            # Show module version
            MODULE_VER=$(cat /sys/module/r8152/version 2>/dev/null)
            if [ -n "${MODULE_VER}" ]; then
                log "Module version: ${MODULE_VER}"
            fi
        else
            log "ERROR: Driver not loaded. Please check dmesg for errors."
            return 1
        fi
    else
        log "ERROR: Driver file not found at ${DRIVER_PATH}"
        return 1
    fi

    # Auto-load on boot is QTS's job: it runs QPKG_SERVICE_PROGRAM with "start"
    # for every enabled QPKG once the data volume is up, and RTL8152_Driver.sh
    # does the vermagic check and the srcversion verification there.
    #
    # Nothing is written to /etc/rc.local: on QTS /etc is a ramdisk rebuilt from
    # the firmware image on every boot, so an edit there is writable, appears to
    # succeed, and is gone by the time it would have run.
    # QTS only runs the boot-time service for packages with Enable = TRUE in
    # /etc/config/qpkg.conf, and QDK carries the old value across an upgrade:
    # pre_install captures it into SYS_QPKG_SERVICE_ENABLED (qinstall.sh:1467) and
    # set_qpkg_status writes it back after this routine returns (qinstall.sh:749).
    # So once the package has been switched off in App Center it stays off and
    # reinstalling cannot clear it, which reads as "install works, reboot does not"
    # because the insmod above is unconditional while the boot path is not.
    #
    # This package is a driver replacement with no meaningful disabled state - its
    # stop does not even unload the module - so installing it means enabling it.
    # pkg_post_install runs in qinstall's own shell (call_defined_routine, :1410),
    # so the variable set here is what set_qpkg_status acts on.
    SYS_QPKG_SERVICE_ENABLED="TRUE"
    log "Auto-load on boot: enabling the QPKG service (${QPKG_NAME}.sh start)"

    # Left behind by earlier builds of this package, which wrote a script that
    # nothing ever invoked.
    if [ -f "${QPKG_ROOT}/rtl8152-autoload.sh" ]; then
        rm -f "${QPKG_ROOT}/rtl8152-autoload.sh"
        log "Removed obsolete rtl8152-autoload.sh"
    fi

    log "=== Installation completed successfully ==="
    echo ""
    echo "=========================================="
    echo "Realtek USB Ethernet Driver installed!"
    echo "=========================================="
    echo "RTL8157 support: USB ID 0bda:8157"
    echo "Auto-load on boot: enabled"
    echo "Log: ${LOG_FILE}"
    echo ""
    if lsmod | grep -q "^r8152 "; then
        echo "Status: Driver loaded successfully"
    else
        echo "Status: Driver installed but not loaded"
        echo "Please run: modprobe r8152"
        echo "Or check: ${LOG_FILE}"
    fi
    echo "=========================================="
}

######################################################################
# Define any package specific operations that shall be performed when
# the package is removed.
######################################################################
PKG_PRE_REMOVE="{
    log \"=== Pre-removal started ===\"

    # Unload driver if loaded
    if lsmod | grep -q \"^r8152 \"; then
        log \"Unloading r8152 driver...\"
        rmmod r8152 2>/dev/null || modprobe -r r8152 2>/dev/null || true
        log \"Driver unloaded\"
    fi
}"

PKG_MAIN_REMOVE="{
    log \"=== Main removal started ===\"
    log \"The QPKG copy is removed by QDK; QTS system modules are untouched\"
}"

PKG_POST_REMOVE="{
    log \"=== Post-removal started ===\"

    # Remove auto-load configuration from various locations
    RC_LOCAL=\"/etc/rc.local\"
    AUTORUN_CONF=\"/etc/config/autorun.conf\"

    # Remove from rc.local if it exists
    if [ -f \"${RC_LOCAL}\" ] && [ -w \"${RC_LOCAL}\" ]; then
        if grep -q \"RTL8152 Driver auto-load\" \"${RC_LOCAL}\"; then
            sed -i '/# RTL8152 Driver auto-load/d' \"${RC_LOCAL}\"
            sed -i '/modprobe r8152.*RTL8152/d' \"${RC_LOCAL}\"
            log \"Removed auto-load from ${RC_LOCAL}\"
        fi
    fi

    # Remove from autorun.conf if it exists
    if [ -f \"${AUTORUN_CONF}\" ] && [ -w \"${AUTORUN_CONF}\" ]; then
        if grep -q \"RTL8152 Driver\" \"${AUTORUN_CONF}\"; then
            sed -i '/modprobe r8152.*RTL8152/d' \"${AUTORUN_CONF}\"
            log \"Removed auto-load from ${AUTORUN_CONF}\"
        fi
    fi

    # Remove our init script if it exists
    if [ -f \"${QPKG_ROOT}/rtl8152-autoload.sh\" ]; then
        rm -f \"${QPKG_ROOT}/rtl8152-autoload.sh\"
        log \"Removed auto-load script\"
    fi

    # Reload the module supplied by QTS after the QPKG module is unloaded.
    log \"Reloading QTS r8152 driver...\"
    modprobe r8152 2>/dev/null || true
    if lsmod | grep -q \"^r8152 \"; then
        log \"QTS driver reloaded successfully\"
    fi

    log \"=== Removal completed ===\"
    echo \"RTL8152 Driver has been removed\"
}"
